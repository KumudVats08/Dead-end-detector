 The default endpoint below expects a Gemini API key.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key
LLM_MODEL=openai/gpt-oss-120b 

# Optional backup OpenAI-compatible LLM; configure all three to enable fallback.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_openai_compatible_api_key
LLM_MODEL=gemini-3.8-flash

# Set to 1 to TINYFISH_API_KEY=your_tinyfish_api_key
#use the bundled offline demo records.
DEMO=0
